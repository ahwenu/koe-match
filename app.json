{
  "expo": {
    "name": "Koe Match",
    "slug": "koe-match",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon-v33.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ahwenu.koematch"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8557A",
        "foregroundImage": "./assets/android-icon-foreground-v33.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ahwenu.koematch"
    },
    "web": {
      "favicon": "./assets/favicon-v33.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "プロフィールの音声を作るため、あなたが許可したときに声を録音します。",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "koematch"
  }
}
